{
  "name": "ecom-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @ecom-agent/shared -w @ecom-agent/server -w @ecom-agent/web",
    "typecheck": "npm run typecheck -w @ecom-agent/shared -w @ecom-agent/server -w @ecom-agent/web",
    "lint": "eslint .",
    "pretest": "npm run build -w @ecom-agent/shared -w @ecom-agent/server",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
