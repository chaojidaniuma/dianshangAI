# ===== LLM Provider（OpenAI 兼容协议，可换供应商）=====
# 可选预设：openai / deepseek / zhipu / qwen(百炼) / custom
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000

# ===== Image Provider（生图，可关闭，关闭时用本地海报兜底）=====
# off / openai-compatible / qwen(百炼 wanx)
IMAGE_PROVIDER=off
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ===== Server =====
PORT=3000
HOST=0.0.0.0
